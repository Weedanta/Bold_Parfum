# Salin file ini jadi .env.local lalu isi dari dashboard Supabase,
# Project Settings > API. Jangan commit .env.local.

# Contoh: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key, formatnya sb_publishable_...
# Aman berada di browser: seluruh akses dibatasi RLS, dan situs hanya membaca.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Proyek lama yang masih memakai kunci JWT bisa mengisi ini sebagai gantinya.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
